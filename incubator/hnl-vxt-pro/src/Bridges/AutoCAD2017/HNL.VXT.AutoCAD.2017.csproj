<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- API-only compatibility probe: net48 is NOT the Autodesk-supported
         framework for AutoCAD 2017. Do not install this binary before
         host-compatible runtime and actual AutoCAD QA are verified. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HNL.VXT.AutoCAD</RootNamespace>
    <AssemblyName>HNL.VXT.AutoCAD</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\HNL.VXT.AutoCAD\*.cs" Link="%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="AutoCAD.NET" Version="21.0.2" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\HNL.VXT.Core\HNL.VXT.Core.csproj" />
    <ProjectReference Include="..\..\HNL.VXT.UI\HNL.VXT.UI.csproj" />
  </ItemGroup>
</Project>
