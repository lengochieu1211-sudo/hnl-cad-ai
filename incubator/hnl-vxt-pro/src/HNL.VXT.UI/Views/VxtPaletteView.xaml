                                <Grid Margin="0,0,0,7" MinHeight="29">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Lấy điểm bắt đầu" Command="{Binding PickManualStartCommand}" IsEnabled="{Binding IsManualStart}" Style="{StaticResource BoundaryPickButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Lấy điểm cửa" Command="{Binding PickDoorCommand}" IsEnabled="{Binding IsDoorStart}" Style="{StaticResource BoundaryPickButton}" Margin="4,0,0,0"/>
                                </Grid>
                                <CheckBox Content="Chèn Block ký hiệu ô trần đầu tiên"
                                          IsChecked="{Binding DrawStartTileBlock, Mode=TwoWay}" Margin="0,4,0,6"/>
                                <StackPanel IsEnabled="{Binding DrawStartTileBlock}">
                                    <TextBlock Text="Block ô đầu HNL mặc định tự khớp hệ tấm và hướng lưới."
                                               TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,5"/>
                                    <Grid MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Block ô đầu" Style="{StaticResource FieldLabel}" ToolTip="Để trống để dùng Block ký hiệu HNL mặc định."/>
                                        <TextBox Grid.Column="1" Text="{Binding StartMarkerBlockName, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Để trống = Block HNL mặc định"/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding PickStartMarkerBlockCommand}"
                                                Style="{StaticResource PickButton}" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <Expander Header="4. Ty treo" IsExpanded="False" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0">
                                    <CheckBox Content="Vẽ Ty treo trên T chính" IsChecked="{Binding DrawHangers, Mode=TwoWay}" Margin="0,0,0,7"/>
                                    <Grid Margin="0,0,0,7" IsEnabled="{Binding DrawHangers}" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Khoảng cách Ty Max (mm)" Style="{StaticResource FieldLabel}"/>
                                        <controls:HnlNumericBox Grid.Column="1" Value="{Binding HangerMaxSpacing, Mode=TwoWay}" Minimum="0" Step="100"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7" IsEnabled="{Binding DrawHangers}" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Khoảng cách Ty đến biên (mm)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                        <controls:HnlNumericBox Grid.Column="1" Value="{Binding HangerEdgeTarget, Mode=TwoWay}" Minimum="0" Step="50"/>
                                    </Grid>
                                    <TextBlock Text="Để 0 nếu dùng khoảng cách mặc định." Style="{StaticResource HintText}" Margin="0,0,0,7"/>
                                    <TextBlock Text="Ưu tiên Block Ty tiêu chuẩn trong DWG; thiếu Block sẽ dùng hình tròn." TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                    <Grid MinHeight="29" IsEnabled="{Binding DrawHangers}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Block Ty treo" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HangerBlockName, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Mặc định: AP_DIEM TY 06.2026. Nếu DWG thiếu Block tiêu chuẩn thì dùng ký hiệu tròn."/>
                                        <Button Grid.Column="2" Content="Chọn" Command="{Binding PickHangerBlockCommand}"
                                                Style="{StaticResource PickButton}" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <Expander Header="5. Kích thước (DIM)" IsExpanded="True" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,8" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Cách ghi DIM" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DimensionOptions}" SelectedItem="{Binding SelectedDimensionMode, Mode=TwoWay}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8" MinHeight="29" IsEnabled="{Binding IsDimensionEnabled}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="DimStyle" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DimStyleOptions}"
                                                  SelectedItem="{Binding SelectedDimensionStyle, Mode=TwoWay}"
                                                  ToolTip="Chọn DimStyle đang có trong bản vẽ. Hiện hành = dùng DIMSTYLE của DWG."/>
                                    </Grid>
                                    <TextBlock Text="Theo lưới và tấm cắt biên: đo riêng phần ô nguyên và từng mép cắt, như bản vẽ mẫu." TextWrapping="Wrap"
                                               Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsGroupedDimension}" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Số ô DIM gộp" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding GroupedDimensionCount, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                    <StackPanel IsEnabled="{Binding IsDimensionEnabled}">
                                        <Grid Margin="0,0,0,7" MinHeight="29">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="73"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="DIM ngang" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding HorizontalPositionOptions}" SelectedItem="{Binding SelectedHorizontalDimPosition, Mode=TwoWay}"/>
                                            <Button Grid.Column="2" Content="Chọn" Command="{Binding PickHorizontalDimensionCommand}" Style="{StaticResource PickButton}" Margin="5,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8" MinHeight="29">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Cách khung (mm)" Style="{StaticResource FieldLabel}"/>
                                            <controls:HnlNumericBox Grid.Column="1" Value="{Binding HorizontalDimDistance, Mode=TwoWay}" Minimum="1" Step="50"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,7" MinHeight="29">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="73"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="DIM dọc" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding VerticalPositionOptions}" SelectedItem="{Binding SelectedVerticalDimPosition, Mode=TwoWay}"/>
                                            <Button Grid.Column="2" Content="Chọn" Command="{Binding PickVerticalDimensionCommand}" Style="{StaticResource PickButton}" Margin="5,0,0,0"/>
                                        </Grid>
                                        <Grid MinHeight="29">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Cách khung (mm)" Style="{StaticResource FieldLabel}"/>
                                            <controls:HnlNumericBox Grid.Column="1" Value="{Binding VerticalDimDistance, Mode=TwoWay}" Minimum="1" Step="50"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource SectionCard}">
                            <Expander Header="6. Layer &amp; hiển thị" IsExpanded="False" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,7" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Hatch khung" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HatchLayer, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7" MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Ty treo" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding HangerLayer, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                    <Grid MinHeight="29">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="DIM" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Text="{Binding DimensionLayer, UpdateSourceTrigger=LostFocus}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource SectionCard}" BorderBrush="{DynamicResource AccentBorder}">
                            <StackPanel>
                                <TextBlock Text="Xem trước • 1 Hatch / mảng trần" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,3"/>
                                <TextBlock Text="{Binding PreviewStatus}" TextWrapping="Wrap" Style="{StaticResource HintText}"/>
                                <Grid Margin="0,8,0,0" MinHeight="29">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Cập nhật" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource RefreshButton}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="Ẩn" Command="{Binding ClearPreviewCommand}" Style="{StaticResource HidePreviewButton}" Margin="2,0,2,0"/>
                                    <Button Grid.Column="2" Content="Mặc định" Command="{Binding ResetCommand}" Style="{StaticResource ResetButton}" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- FOOTER: primary action only. Build/version identity lives in the header. -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="6,4">
            <StackPanel>
                <Button HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCreateButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCeilingTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Tạo khung trần nổi" Command="{Binding LayIn.CreateCommand}" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCeilingTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
