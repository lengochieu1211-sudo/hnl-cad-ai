<UserControl x:Class="HNL.VXT.UI.Views.VxtPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HNL.VXT.UI.Controls"
             Background="#F4F6F8">
    <UserControl.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9E0E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:HnlLogo Grid.Column="0" Margin="0,0,11,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="HNL Tool - Vẽ Xương Trần" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VersionLabel}" Foreground="#7DD3FC" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="PHẠM VI &amp; HƯỚNG BỐ TRÍ" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Chọn / Chọn lại biên trần trên CAD" Command="{Binding SelectBoundaryCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding BoundaryStatus}" Foreground="#475569" TextWrapping="Wrap" Margin="2,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Hướng Xương chính" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DirectionDegrees, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/>
                            <Button Grid.Column="2" Content="Chọn 2 điểm" Command="{Binding PickDirectionCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <CheckBox IsChecked="{Binding DrawMain}" DockPanel.Dock="Right" VerticalAlignment="Center">Bật</CheckBox>
                            <TextBlock Text="XƯƠNG CHÍNH (XC)" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khoảng cách Min" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding MainMinSpacing, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khoảng cách Max" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding MainMaxSpacing, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <CheckBox IsChecked="{Binding DrawFurring}" DockPanel.Dock="Right" VerticalAlignment="Center">Bật</CheckBox>
                            <TextBlock Text="XƯƠNG PHỤ (XP)" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khoảng cách" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding FurringSpacing, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <CheckBox IsChecked="{Binding DrawHangers}" DockPanel.Dock="Right" VerticalAlignment="Center">Bật</CheckBox>
                            <TextBlock Text="TY TREO" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khoảng cách Min" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding HangerMinSpacing, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Khoảng cách Max" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding HangerMaxSpacing, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="DIMENSION - HIỂN THỊ TRỰC TIẾP TRÊN CAD" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding DimMain}" Content="XC" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Vị trí" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding DimensionPositions}" SelectedItem="{Binding MainDimPosition}"/><Button Grid.Column="3" Content="Pick" Command="{Binding PickMainDimCommand}"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding DimFurring}" Content="XP" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Vị trí" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding DimensionPositions}" SelectedItem="{Binding FurringDimPosition}"/><Button Grid.Column="3" Content="Pick" Command="{Binding PickFurringDimCommand}"/>
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding DimHanger}" Content="Ty" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Vị trí" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding DimensionPositions}" SelectedItem="{Binding HangerDimPosition}"/><Button Grid.Column="3" Content="Pick" Command="{Binding PickHangerDimCommand}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Offset DIM" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding DimensionDistance, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Background="#F0F9FF" BorderBrush="#BAE6FD">
                    <StackPanel>
                        <TextBlock Text="LIVE PREVIEW" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding PreviewStatus}" Margin="0,5,0,0" Foreground="#0369A1" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="-3,6,0,0">
                            <Button Content="Cập nhật" Command="{Binding RefreshPreviewCommand}"/>
                            <Button Content="Ẩn Preview" Command="{Binding ClearPreviewCommand}"/>
                            <Button Content="Mặc định" Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel>
                <Button Style="{StaticResource PrimaryButton}" Content="✓ TẠO KHUNG XƯƠNG TRẦN" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="Alpha.1: Tạo thật đang khóa đến khi Golden Test khớp V6.7.4." FontSize="10" Foreground="#64748B" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
