<UserControl x:Class="HNL.VXT.UI.Controls.HnlNumericBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="12"
             MinHeight="30">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="ValueTextBox" TextAlignment="Right"
                 VerticalContentAlignment="Center" Padding="7,2"
                 ToolTip="Nhập số hoặc phép tính: 1220/3, 600+25, 2*450, (1200-100)/2. Dùng phím ↑/↓ để tăng giảm theo bước."
                 TextChanged="ValueTextBox_TextChanged" LostFocus="ValueTextBox_LostFocus"
                 PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                 PreviewMouseWheel="ValueTextBox_PreviewMouseWheel"/>
        <TextBlock Grid.Column="1" Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center" Opacity="0.72">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="4,0,0,0"/>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Margin" Value="0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
