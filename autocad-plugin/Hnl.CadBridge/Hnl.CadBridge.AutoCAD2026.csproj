<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Hnl.CadBridge</AssemblyName>
    <Version>2.7.12</Version>
    <AssemblyVersion>2.7.12.0</AssemblyVersion>
    <FileVersion>2.7.12.0</FileVersion>
    <InformationalVersion>2.7.12</InformationalVersion>
    <RootNamespace>Hnl.CadBridge</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
