{
  "name": "hnl-cad-ai",
  "private": true,
  "version": "2.8.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run prepare:lisp && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .\"",
    "build:autocad": "node scripts/build-autocad-bundle.mjs",
    "pack:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --x64 --publish never",
    "dist:win": "npm run build && npm run build:autocad && npm run pack:win",
    "prepare:lisp": "node scripts/prepare-legacy-lisp.mjs",
    "audit:lisp-taxonomy": "node scripts/audit-lisp-taxonomy.mjs",
    "audit:master": "node scripts/master-audit.mjs",
    "audit:bridge": "node scripts/audit-bridge-p0.mjs",
    "audit:ai-agent": "node scripts/audit-ai-agent.mjs"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@tailwindcss/vite": "4.1.14",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.2.3",
    "express": "4.21.2",
    "dotenv": "17.2.3",
    "motion": "12.23.24"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "autoprefixer": "10.4.21",
    "esbuild": "0.25.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.21.0",
    "typescript": "5.8.2",
    "vite": "6.2.3",
    "@types/express": "4.17.21",
    "electron": "38.0.0",
    "electron-builder": "26.0.12",
    "wait-on": "8.0.4",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0"
  },
  "productName": "HNL CAD AI",
  "description": "HNL CAD AI v2.8.2 - AI CAD Agent Preview + Bridge P0 hardening + AutoCAD 2023-2027",
  "main": "electron/main.cjs",
  "build": {
    "appId": "vn.hnl.cadai",
    "productName": "HNL CAD AI",
    "asar": true,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "HNL_CAD_AI_Setup_${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HNL CAD AI",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowElevation": true
    },
    "extraResources": [
      {
        "from": "electron/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "autocad-plugin/HNL.CadBridge.bundle",
        "to": "autocad/HNL.CadBridge.bundle",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/legacy-lisp/extracted",
        "to": "legacy-lisp",
        "filter": [
          "**/*.lsp",
          "**/*.arx",
          "legacy-lisp-index.json"
        ]
      },
      {
        "from": "resources/legacy-lisp/legacy-lisp-manifest.json",
        "to": "legacy-lisp/legacy-lisp-manifest.json"
      }
    ]
  },
  "author": "HNL"
}
